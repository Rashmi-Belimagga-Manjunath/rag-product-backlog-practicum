  "decisions": [
    {
      "decision_id": "DEC-A-01",
      "product_id": "PROD-A",
      "about_entity_id": "FEAT-A-01",
      "decision": "Move tax collection to day three of the onboarding ramp rather than requiring it during sign-up.",
      "rationale": "Early testing showed the long sign-up form caused abandonment in the first session. Asking later, once the user has seen value, raised completion of the tax step from 54% to 88%.",
      "decided_date": "2026-07-16",
      "decided_by_role": "Senior Product Manager"
    },
    {
      "decision_id": "DEC-B-01",
      "product_id": "PROD-B",
      "about_entity_id": "FEAT-B-01",
      "decision": "Ship the streak saver prompt only in the evening, not on waking.",
      "rationale": "Morning prompts were being dismissed unread. Evening is when people are already opening the app.",
      "decided_date": "2026-08-01",
      "decided_by_role": "Founder"
    }
  ],
  "meeting_notes": [
    {
      "note_id": "NOTE-A-01",
      "product_id": "PROD-A",
      "about_entity_ids": [
        "FEAT-A-03",
        "PBI-A-014"
      ],
      "meeting_date": "2026-05-08",
      "attendees_role": [
        "Product Manager",
        "Engineering lead"
      ],
      "topics": [
        "Managers are approving roughly forty rows at a time, so the per-row click is the bottleneck",
        "Not doing partial-batch approval this quarter, it complicates the audit trail",
        "Need to check the ledger is not the slow part before committing to a date"
      ]
    },
    {
      "note_id": "NOTE-B-01",
      "product_id": "PROD-B",
      "about_entity_ids": [
