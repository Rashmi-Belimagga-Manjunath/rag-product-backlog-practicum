  "requirements": [
    {
      "requirement_id": "REQ-A-01",
      "prd_id": "PRD-A-01",
      "product_id": "PROD-A",
      "title": "Tax details are collected progressively",
      "statement": "Tax documentation must be collected after the employee's first successful login, not as part of initial account registration.",
      "is_normative": true
    },
    {
      "requirement_id": "REQ-A-02",
      "prd_id": "PRD-A-01",
      "product_id": "PROD-A",
      "title": "Identity is verified before payment privileges",
      "statement": "An employee must not be granted payment privileges until identity verification has succeeded.",
      "is_normative": true
    },
    {
      "requirement_id": "REQ-A-03",
      "prd_id": "PRD-A-02",
      "product_id": "PROD-A",
      "title": "Managers approve timesheets in bulk",
      "statement": "A manager must be able to approve multiple timesheets in one action where all selected timesheets are complete.",
      "is_normative": true
    },
    {
      "requirement_id": "REQ-A-04",
      "prd_id": "PRD-A-02",
      "product_id": "PROD-A",
      "title": "Payroll exports follow a fixed schedule",
      "statement": "Payroll exports must run on a fixed, pre-configured schedule and must not be triggered ad hoc by end users.",
      "is_normative": true
    },
    {
      "requirement_id": "REQ-B-01",
      "prd_id": "PRD-B-01",
      "product_id": "PROD-B",
      "title": "Streak loss is mitigated before it occurs",
      "statement": "The product must offer a reduced-effort alternative before a user breaks an established streak.",
      "is_normative": true
    }
  ],
